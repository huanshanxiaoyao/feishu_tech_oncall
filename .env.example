# 飞书应用凭证（开发者后台 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 机器人自己的 open_id（同一页面"机器人"卡片里能看到，或调 bot/v3/info 拿）
# 用来判断"消息里 @ 的是不是我自己"，SDK 没有现成的查询接口，只能手填。
FEISHU_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接入方式：ws=长连接（默认，无需公网/证书）｜ http=事件回调（本次只留接口，未实现）
FEISHU_MODE=ws

# 干跑模式：1 = 不真的调飞书 API，把要发送/更新的卡片 JSON 打印到日志里
# 用于 scripts/fake_event.py 自测，或在等待飞书应用审批期间验证逻辑
DRY_RUN=0

# SQLite 数据库文件路径
DB_PATH=./data/badcase_bot.db

# 日志级别
LOG_LEVEL=INFO

# ==== 第二步：排查 Agent（Claude Agent SDK）====

# Anthropic API Key（https://console.anthropic.com/ -> API Keys）
# DRY_RUN=1 时不会真的调用，可以留空
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 备用鉴权：走内部代理而不是官方 API Key（两组任填一组即可，AUTH_TOKEN/BASE_URL 优先于 API_KEY）
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# 排查用的模型
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# 单次排查最多走多少个 Agent turn / 最多花多少美元 / 硬超时多少秒。
# 这三个是"兜底防跑飞"，不是预期开销——线上实测跑完的 case 是 19/49/62 轮、
# $0.35~$0.68；卡住的两次分别是烧完 $1 和撞上 90 轮。留 3~4 倍余量。
# 超时要留在轮次上限之上（实测约 4.5 秒/轮，180 轮 ≈ 810 秒），
# 否则轮次还没用完就先被超时砍掉。
AGENT_MAX_TURNS=180
AGENT_MAX_BUDGET_USD=3.0
AGENT_TIMEOUT_SECONDS=1200

# 排查过程中每隔多少秒把"正在查什么"更新回卡片一次
AGENT_PROGRESS_UPDATE_INTERVAL_SECONDS=20

# 收到 SIGTERM 后留给"还在跑的排查"的收尾时间，超过就 cancel 并把卡片更新成「已中断」。
# 必须显著小于 systemd unit 里的 TimeoutStopSec（当前 45s），否则还是会被 SIGKILL。
SHUTDOWN_GRACE_SECONDS=20

# 目标注册表：Agent 能访问哪些代码/日志/数据库/命令的白名单配置
# 先拷贝 config/targets.example.yaml 到这个路径，再按需要填真实目录/连接串
TARGETS_REGISTRY_PATH=./config/targets.yaml

# Agent 唯一有写权限的目录（其余全部只读）
SCRATCH_DIR=./data/scratch

# ==== 分诊/防护闸门（指令合理性判断） ====

# 分诊用的模型，留空则回退到 CLAUDE_MODEL。分诊只是单轮零工具的分类调用，
# 有更便宜/更快的模型可用时可以单独配置。
TRIAGE_MODEL=

# 命中破坏性指令后，该用户多少秒内不再受理新请求
LOCKOUT_DURATION_SECONDS=3600

# ai4all_bridge 数据库只读账号 DSN（先执行 deploy/create_readonly_db_role.sql 建号）
# config/targets.yaml 里 databases[].dsn_env 指向这个变量名
# DB_DSN_AI4ALL_BRIDGE=postgresql://tech_oncall_ro:xxxxxxxx@127.0.0.1:55432/ai4all_dev
